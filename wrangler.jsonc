// Takoras (version React) : site statique construit par Vite dans dist/.
// - build.command : wrangler construit le site avant chaque envoi (prod et previews).
// - not_found_handling SPA : toutes les URL (/inventaire, /profil/x…) renvoient index.html, React gère la page.
// - previews : la branche `react` obtient une URL de preview isolée (sans toucher la prod), si les
//   « Builds for Preview branches » sont activés dans Workers & Pages > takoras > Settings > Builds.
{
  "name": "takoras",
  "compatibility_date": "2026-10-01",
  "build": { "command": "npm ci && npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "preview_urls": true,
  "previews": {}
}
